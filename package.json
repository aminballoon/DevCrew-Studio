{
  "name": "devcrew-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent development pipeline over ACP, with human approval gates and a benchmark harness.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dashboard": "tsx src/dashboard/server.ts",
    "run": "tsx src/cli.ts",
    "bench": "tsx bench/runner/run.ts",
    "studio": "npx @langchain/langgraph-cli dev",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=120000 \"test/**/*.test.ts\"",
    "pipeline": "tsx src/pipeline/cli.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
